<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>날씨 & 건강 맞춤 코디 추천</title>
    <style>
        :root {
            --bg-color: #f0f2f5;
            --card-color: #ffffff;
            --primary-color: #4a90e2;
            --text-color: #333;
            
            /* 옷 색상 변수 */
            --top-color: #e0e0e0;
            --bottom-color: #555555;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            max-width: 900px;
            width: 100%;
            background: var(--card-color);
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

        @media (max-width: 768px) {
            .container { grid-template-columns: 1fr; }
        }

        /* 왼쪽: 컨트롤러 및 추천창 */
        .controls-section {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        h1 { margin: 0; font-size: 1.8rem; color: #222; }
        h2 { margin: 0 0 10px 0; font-size: 1.2rem; color: #555; }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        select, input {
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1fr;
        }

        button {
            padding: 12px;
            background: var(--primary-color);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s;
        }

        button:hover { background: #357abd; }

        .recommendation-box {
            background: #eef5fc;
            padding: 15px;
            border-radius: 10px;
            border-left: 5px solid var(--primary-color);
        }

        /* 오른쪽: 캐릭터 캔버스 */
        .avatar-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #f9f9f9;
            border-radius: 15px;
            padding: 20px;
            position: relative;
        }

        /* SVG 캐릭터 스타일링 */
        .avatar-svg {
            width: 250px;
            height: 350px;
        }

        /* 아이템 표시/숨김 제어용 클래스 */
        .hide { display: none; }
    </style>
</head>
<body>

<div class="container">
    <div class="controls-section">
        <div>
            <h1>상태 맞춤 코디룸 👗</h1>
            <p style="color: #777; margin: 5px 0 0 0;">날씨와 건강 상태를 입력하면 캐릭터가 옷을 입어요!</p>
        </div>
        
        <hr style="border: 0; border-top: 1px solid #eee; margin: 0;">

        <div class="form-group">
            <label for="season">현재 계절</label>
            <select id="season">
                <option value="spring">봄 🌸</option>
                <option value="summer">여름 ☀️</option>
                <option value="autumn">가을 🍁</option>
                <option value="winter">겨울 ❄️</option>
            </select>
        </div>

        <div class="form-group">
            <label for="temperature">현재 온도 (°C)</label>
            <input type="number" id="temperature" value="22" placeholder="온도를 입력하세요">
        </div>

        <div class="form-group">
            <label for="health">건강 상태</label>
            <select id="health">
                <option value="good">정상 😀</option>
                <option value="cold">감기 기운 😷 (따뜻하게!)</option>
                <option value="hot">더위를 많이 탐 🥵 (시원하게!)</option>
            </select>
        </div>

        <button onclick="recommendOutfit()">추천 의상 입히기 ✨</button>

        <div class="recommendation-box">
            <h2>💡 오늘의 추천 코디</h2>
            <div id="recommend-text">조건을 입력하고 버튼을 눌러주세요.</div>
        </div>

        <hr style="border: 0; border-top: 1px solid #eee; margin: 0;">

        <div>
            <h2>수동으로 캐릭터 꾸미기 🎨</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div class="form-group">
                    <label>상의 색상</label>
                    <input type="color" id="topColorPicker" value="#e0e0e0" onchange="changeColor('top', this.value)">
                </div>
                <div class="form-group">
                    <label>하의 색상</label>
                    <input type="color" id="bottomColorPicker" value="#555555" onchange="changeColor('bottom', this.value)">
                </div>
            </div>
            <div style="margin-top: 10px; display: flex; gap: 15px;">
                <label><input type="checkbox" id="toggleGlasses" onchange="toggleItem('glasses', this.checked)"> 안경 착용</label>
                <label><input type="checkbox" id="toggleMask" onchange="toggleItem('mask', this.checked)"> 마스크 착용</label>
                <label><input type="checkbox" id="toggleCoat" onchange="toggleItem('coat', this.checked)"> 코트 추가</label>
            </div>
        </div>
    </div>

    <div class="avatar-section">
        <svg class="avatar-svg" viewBox="0 0 200 300">
            <circle cx="100" cy="150" r="90" fill="#eef2f7" />

            <rect x="93" y="100" width="14" height="20" fill="#ffdbac" />
            <circle cx="100" cy="75" r="30" fill="#ffdbac" />
            <circle cx="90" cy="70" r="3" fill="#333" />
            <circle cx="110" cy="70" r="3" fill="#333" />
            <path d="M 95 85 Q 100 90 105 85" stroke="#333" stroke-width="2" fill="none" id="avatar-mouth"/>
            <path d="M 70 70 Q 100 40 130 70 Q 100 55 70 70" fill="#4a3728" />

            <rect x="85" y="200" width="12" height="60" fill="#ffdbac" />
            <rect x="103" y="200" width="12" height="60" fill="#ffdbac" />
            <rect x="80" y="255" width="18" height="10" rx="3" fill="#333" />
            <rect x="102" y="255" width="18" height="10" rx="3" fill="#333" />

            <rect id="item-bottom" x="80" y="150" width="40" height="50" fill="#555555" />

            <g id="item-top-group">
                <rect id="item-top" x="75" y="115" width="50" height="40" fill="#e0e0e0" />
                <rect id="item-left-arm" x="63" y="115" width="12" height="35" fill="#e0e0e0" />
                <rect id="item-right-arm" x="125" y="115" width="12" height="35" fill="#e0e0e0" />
            </g>

            <g id="item-coat" class="hide">
                <rect x="70" y="115" width="60" height="70" fill="#3e2723" opacity="0.9" />
                <line x1="100" y1="115" x2="100" y2="185" stroke="#fff" stroke-width="1" />
            </g>

            <g id="item-glasses" class="hide">
                <circle cx="90" cy="70" r="7" stroke="#000" stroke-width="2" fill="none" />
                <circle cx="110" cy="70" r="7" stroke="#000" stroke-width="2" fill="none" />
                <line x1="97" y1="70" x2="103" y2="70" stroke="#000" stroke-width="2" />
            </g>

            <path id="item-mask" class="hide" d="M 80 75 Q 100 95 120 75 Q 100 85 80 75" fill="#ffffff" stroke="#ccc" />
        </svg>
    </div>
</div>

<script>
    // 의상 색상 직접 변경 함수 (꾸미기용)
    function changeColor(type, color) {
        if(type === 'top') {
            document.getElementById('item-top').setAttribute('fill', color);
            document.getElementById('item-left-arm').setAttribute('fill', color);
            document.getElementById('item-right-arm').setAttribute('fill', color);
            document.getElementById('topColorPicker').value = color;
        } else if(type === 'bottom') {
            document.getElementById('item-bottom').setAttribute('fill', color);
            document.getElementById('bottomColorPicker').value = color;
        }
    }

    // 아이템 On/Off 함수 (꾸미기용)
    function toggleItem(itemId, isShow) {
        const item = document.getElementById(`item-${itemId}`);
        const checkbox = document.getElementById(`toggle${itemId.charAt(0).toUpperCase() + itemId.slice(1)}`);
        
        if(isShow) {
            item.classList.remove('hide');
            if(checkbox) checkbox.checked = true;
        } else {
            item.classList.add('hide');
            if(checkbox) checkbox.checked = false;
        }
    }

    // 핵심 알고리즘: 날씨와 건강 상태에 맞는 의상 추천 및 반영
    function recommendOutfit() {
        const season = document.getElementById('season').value;
        const temp = parseFloat(document.getElementById('temperature').value);
        const health = document.getElementById('health').value;

        let recommendText = "";
        let topColor = "#e0e0e0";
        let bottomColor = "#333333";
        
        // 기본 UI 초기화
        toggleItem('coat', false);
        toggleItem('mask', false);
        toggleItem('glasses', false);
        
        // 1. 체감 온도 보정 (건강 상태에 따라 사용자가 느끼는 온도를 가상 조절)
        let perceptTemp = temp;
        if (health === 'cold') {
            perceptTemp -= 4; // 감기 기운이 있으면 더 춥게 느낌 -> 더 따뜻하게 입도록
            toggleItem('mask', true); // 감기 걸리면 마스크 필수 착용
        } else if (health === 'hot') {
            perceptTemp += 4; // 더위를 타면 실제보다 더 덥게 느낌 -> 더 시원하게 입도록
        }

        // 2. 보정된 온도 기반 기본 의상 레이아웃 설정
        if (perceptTemp >= 28) {
            recommendText = "☀️ <b>린넨 셔츠나 반팔티와 반바지</b>를 추천합니다. 자외선 차단에 신경 쓰세요!";
            topColor = "#ffffff"; // 시원한 흰색 반팔
            bottomColor = "#4a90e2"; // 시원한 파란 반바지 느낌
            // 반팔 느낌을 내기 위해 팔 길이 조정 (기본 SVG에서 팔 크기 축소)
            document.getElementById('item-left-arm').setAttribute('height', '15');
            document.getElementById('item-right-arm').setAttribute('height', '15');
        } 
        else if (perceptTemp >= 20 && perceptTemp < 28) {
            recommendText = "🌸 <b>가벼운 셔츠, 얇은 긴팔티에 슬랙스나 면바지</b>가 적당한 날씨입니다.";
            topColor = "#f8bbd0"; // 화사한 핑크/베이지 계열
            bottomColor = "#795548"; 
            document.getElementById('item-left-arm').setAttribute('height', '35');
            document.getElementById('item-right-arm').setAttribute('height', '35');
        } 
        else if (perceptTemp >= 10 && perceptTemp < 20) {
            recommendText = "🍁 <b>자켓, 셔츠, 가디건을 레이어드</b>하고 긴바지를 입으세요. 일교차에 주의하세요!";
            topColor = "#b0bec5"; 
            bottomColor = "#37474f";
            document.getElementById('item-left-arm').setAttribute('height', '35');
            document.getElementById('item-right-arm').setAttribute('height', '35');
            toggleItem('coat', true); // 자켓/코트 레이어 추가
        } 
        else {
            recommendText = "❄️ <b>두꺼운 패딩이나 코트, 목도리, 기모 바지</b> 필수! 무조건 따뜻하게 입으셔야 합니다.";
            topColor = "#263238";
            bottomColor = "#1a237e";
            document.getElementById('item-left-arm').setAttribute('height', '35');
            document.getElementById('item-right-arm').setAttribute('height', '35');
            toggleItem('coat', true);
        }

        // 3. 계절 감성 멘트 추가
        if(season === 'winter' && temp < 5) {
            recommendText += " (겨울철 빙판길 조심하세요!)";
        } else if (season === 'summer' && health === 'good') {
            recommendText += " (수분 섭취를 충분히 해주세요!)";
        }

        // 4. 캐릭터 화면 및 컨트롤러에 실시간 반영
        document.getElementById('recommend-text').innerHTML = recommendText;
        changeColor('top', topColor);
        changeColor('bottom', bottomColor);
    }

    // 페이지 시작 시 최초 1회 자동 실행
    window.onload = function() {
        recommendOutfit();
    };
</script>

</body>
</html>
